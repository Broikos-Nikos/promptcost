{
  "name": "promptcost",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run check && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "npm run check:source && npm run check:licence && npm run check:density && npm run check:grain && npm run check:claims",
    "check:source": "node tools/check-source.mjs",
    "check:licence": "node tools/check-licence.mjs",
    "check:density": "node tools/check-density.mjs",
    "check:grain": "node tools/check-grain.mjs",
    "check:claims": "node tools/check-claims.mjs",
    "check:page": "node tools/check-page.mjs",
    "check:capture": "node tools/check-capture.mjs",
    "build:density": "node tools/build-density.mjs",
    "capture": "node tools/capture.mjs",
    "verify": "node tools/verify.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "gpt-tokenizer": "4.0.0",
    "playwright": "1.61.1",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  },
  "allowScripts": {
    "fsevents": true
  }
}
